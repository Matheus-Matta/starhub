# dev (padrao): SQLite, Celery na memoria (executa na hora), channels na memoria.
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------------------------------------------------------------------------
# PRODUCAO (Docker: docker-compose.yml). O compose ja forca config.settings.prod.
# ---------------------------------------------------------------------------
# Obrigatorias:
# DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# DJANGO_ALLOWED_HOSTS=hub.suaempresa.com.br
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.suaempresa.com.br

# Banco PostgreSQL (fora do compose).
# POSTGRES_DB=starhub
# POSTGRES_USER=starhub
# POSTGRES_PASSWORD=
# POSTGRES_HOST=ip-ou-host-do-banco
# POSTGRES_PORT=5432
# require em banco gerenciado (RDS, Supabase...)
# POSTGRES_SSLMODE=prefer
# 0 se usar pgbouncer
# POSTGRES_CONN_MAX_AGE=60

# Redis: o compose sobe o dele (redis://redis:6379/0); so mude para um Redis de fora.
# REDIS_URL=redis://redis:6379/0

# CORS: dominios que chamam o hub pelo navegador (o tema da loja enviando avaliacoes).
# CORS_ALLOWED_ORIGINS=https://www.sualoja.com.br,https://sua-loja.myshopify.com
# rotas com CORS (padrao: avaliacoes)
# CORS_URLS_REGEX=^/integracoes/shopify/avaliacoes/

# HTTPS: o proxy na frente (TLS) avisa por X-Forwarded-Proto. Desligue so para testar
# em http://ip:8000 sem proxy.
# DJANGO_SSL_REDIRECT=1
# o app serve /media/; 0 se o nginx servir a pasta
# SERVIR_MEDIA=1
# LOG_LEVEL=INFO

# Docker
# ou :v1.2.3, :sha-abc1234
# STARHUB_IMAGE=ghcr.io/matheus-matta/starhub:latest
# portas dos dois backends (blue e green); o balanceador reparte entre elas
# WEB_PORT_BLUE=8001
# WEB_PORT_GREEN=8002
# processos do uvicorn
# WEB_WORKERS=2
# tarefas ao mesmo tempo no worker
# CELERY_CONCURRENCY=4

# Endereco publico do hub: o e-mail de notificacao leva o link do registro.
# STARHUB_URL_PUBLICA=https://hub.suaempresa.com.br

# Validade do token JWT da API Woo (dias). O plugin JWT do WordPress usa 7.
# JWT_ACESSO_DIAS=7

# Conta inicial e superusuario: python manage.py criar_conta_inicial
# em prod a senha precisa passar nos validadores de senha do Django
USER_ADMIN=admin
PASSWORD_ADMIN=
ACCOUNT_ADMIN=starhub
# EMAIL_ADMIN=admin@suaempresa.com.br
